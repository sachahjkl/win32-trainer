{
  "tasks": [
    {
      "type": "process",
      "label": "Build in debug mode",
      "command": "build.bat",
      "args": ["debug"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        {
          "base": "$msCompile",
          "fileLocation": ["autoDetect", "${workspaceFolder}"]
        }
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Builds the project."
    },
    {
      "type": "process",
      "label": "Build in release mode",
      "command": "build.bat",
      "args": ["release"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        {
          "base": "$msCompile",
          "fileLocation": ["autoDetect", "${workspaceFolder}"]
        }
      ],
      "group": "build",
      "detail": "Builds the project."
    },
    {
      "type": "process",
      "label": "Clean build directory",
      "command": "build.bat",
      "args": ["clean"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build",
      "detail": "Deletes the build directory."
    }
  ],
  "version": "2.0.0"
}
